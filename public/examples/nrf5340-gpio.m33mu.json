{
  "schemaVersion": 2,
  "projectId": "example-nrf5340-gpio",
  "name": "nRF5340 DK GPIO: D2 switch lights D3, Button 1 lights LED1",
  "simulator": {
    "cpu": "nrf5340",
    "firmwareFormat": "elf",
    "firmwareSha256": "b1b119ce09af5583f37da30ec4456595d7a04d88aa4388b237c8e014295bdfde",
    "firmwareName": "nrf5340-gpio.elf"
  },
  "boards": [
    {
      "id": "board1",
      "cpu": "nrf5340",
      "layoutRevision": "nRF5340 DK (Zephyr Arduino map)",
      "x": 0,
      "y": 0
    }
  ],
  "parts": [
    {
      "id": "sw1",
      "kind": "switch",
      "x": 300,
      "y": 760,
      "rotation": 0,
      "params": {}
    },
    {
      "id": "r1",
      "kind": "resistor",
      "x": 450,
      "y": 840,
      "rotation": 0,
      "params": {
        "ohms": 330
      }
    },
    {
      "id": "led1",
      "kind": "led",
      "x": 620,
      "y": 840,
      "rotation": 0,
      "params": {
        "color": "green"
      }
    },
    {
      "id": "gnd1",
      "kind": "ground",
      "x": 720,
      "y": 940,
      "rotation": 0,
      "params": {}
    }
  ],
  "wires": [
    {
      "id": "w1",
      "from": {
        "kind": "board",
        "board": "board1",
        "contact": "ARD_DLOW-6"
      },
      "to": {
        "kind": "part",
        "part": "sw1",
        "terminal": "a"
      },
      "color": "#f4d35e"
    },
    {
      "id": "w2",
      "from": {
        "kind": "part",
        "part": "sw1",
        "terminal": "b"
      },
      "to": {
        "kind": "board",
        "board": "board1",
        "contact": "ARD_DHIGH-4"
      },
      "color": "#222222"
    },
    {
      "id": "w3",
      "from": {
        "kind": "board",
        "board": "board1",
        "contact": "ARD_DLOW-5"
      },
      "to": {
        "kind": "part",
        "part": "r1",
        "terminal": "a"
      },
      "color": "#2fb34a"
    },
    {
      "id": "w4",
      "from": {
        "kind": "part",
        "part": "r1",
        "terminal": "b"
      },
      "to": {
        "kind": "part",
        "part": "led1",
        "terminal": "a"
      },
      "color": "#2fb34a"
    },
    {
      "id": "w5",
      "from": {
        "kind": "part",
        "part": "led1",
        "terminal": "k"
      },
      "to": {
        "kind": "part",
        "part": "gnd1",
        "terminal": "g"
      },
      "color": "#222222"
    },
    {
      "id": "w6",
      "from": {
        "kind": "part",
        "part": "gnd1",
        "terminal": "g"
      },
      "to": {
        "kind": "board",
        "board": "board1",
        "contact": "ARD_POWER-6"
      },
      "color": "#222222"
    }
  ],
  "instruments": {
    "scopes": [
      {
        "id": "scope1",
        "name": "Scope 1",
        "channels": [
          {
            "kind": "voltage",
            "at": {
              "kind": "board",
              "board": "board1",
              "contact": "ARD_DLOW-6"
            }
          },
          {
            "kind": "voltage",
            "at": {
              "kind": "board",
              "board": "board1",
              "contact": "ARD_DLOW-5"
            }
          }
        ],
        "windowNs": 20000000
      }
    ]
  },
  "solver": {
    "lookaheadNs": 100000,
    "sampleNs": 10000
  },
  "ui": {
    "zoom": 0.5,
    "panX": 60,
    "panY": 20
  }
}
